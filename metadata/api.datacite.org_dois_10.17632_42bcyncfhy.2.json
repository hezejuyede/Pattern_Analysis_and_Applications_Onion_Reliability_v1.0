tsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This dataset provides a structured collection of 16,300 images of red and white onion (Allium cepa L.) bulbs and leaves, developed to facilitate research in agriculture, computer vision, and machine learning. Bulb images are organized into red onion and white onion categories, which are further divided into healthy and unhealthy groups, and sub-categorized into single and multiple bulb samples. All images have been standardized to a uniform resolution of 1024 × 720 pixels and 96DPI using IrfanView software, with serial numbering 'Onion#####' applied for traceability. The dataset provides only raw images, allowing users to perform their own augmentation and preprocessing.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://data.mendeley.com/datasets/42bcyncfhy/2","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-09T04:54:20.000Z","registered":"2026-02-09T04:54:20.000Z","published":"2026","updated":"2026-02-09T04:54:20.000Z"},"relationships":{"client":{"data":{"id":"bl.mendeley","type":"clients"}},"provider":{"data":{"id":"elsevier","type":"providers"}},"media":{"data":{"id":"10.17632/42bcyncfhy.2","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.17632/42bcyncfhy","type":"dois"}]}}}}