  "findings": [
    {
      "severity": "interpretation_required",
      "finding": "Four evidence units are complementary audit questions across separate datasets and endpoints, not an empirically identified four-stage causal or numerical decomposition.",
      "action": "Replace claims that one common material forms a progressively nested measured chain; report augmented-archive interventions and binary external transport as separate complementary experiments."
    },
    {
      "severity": "interpretation_required",
      "finding": "Old same-number random split seeds do not match test images or training families.",
      "action": "Call the original result a split-scheme contrast. Use the new fixed-anchor/fixed-budget intervention for the conditional within-archive sibling-substitution claim, without numerically merging effect sizes."
    },
    {
      "severity": "precision_limit",
      "finding": "Only four purple-blotch probe families and two sentinel families occur per seed; an individual error changes four-class balanced accuracy by 0.0625 or 0.125 respectively. Repeated seeds reuse the archive.",
      "action": "Retain class support and split-variation ranges; do not treat 30 seeds as 30 biological replicates or claim precise pathology-specific effects."
    },
    {
      "severity": "interpretation_required",
      "finding": "Sentinel near-zero or sign-changing effects are compatible with split variation but do not establish equivalence or absence of global effects.",
      "action": "Report all sentinel results and localization contrasts with their ranges. Do not use seed significance tests or declare equivalence without a justified margin and independent replication."
    },
    {
      "severity": "uncertainty_limit",
      "finding": "Bootstrap resampling keeps fitted models and prediction streams fixed; COLD exact-SHA groups are singleton images with unknown biological clusters.",
      "action": "Describe conditional image/day uncertainty, not full training-procedure or biological uncertainty."
    },
    {
      "severity": "protocol_boundary",
      "finding": "Same-class donor matching deliberately uses augmented-archive class labels; both new analyses were designed after original target results were known.",
      "action": "Call them post hoc diagnostic/sensitivity analyses; neither is label-free deployment, a new independent external validation, or a prospectively preregistered primary study."
    },
    {
      "severity": "remaining_calibration_limit",
      "finding": "Fixed-C OOF calibration removes mixed-C score construction but both arms still transfer from fold-trained to full-source-fitted heads.",
      "action": "Interpret persistence of external failure as robustness to the tested construction only, not proof that all possible score-scale effects have been eliminated."
    }
  ],
